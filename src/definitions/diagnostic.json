{
  "diagnostic_id": "evercompass",
  "name": "EverCompass Diagnostic",
  "version": "1.0.0",
  "status": "draft",
  "journey_stages": [
    {
      "id": "attract",
      "label": "Attract",
      "description": "The customer discovers the business and becomes aware of its existence."
    },
    {
      "id": "engage",
      "label": "Engage",
      "description": "The customer evaluates the business, its value, and its experience."
    },
    {
      "id": "convert",
      "label": "Convert",
      "description": "The customer takes a meaningful action or becomes a customer/opportunity."
    },
    {
      "id": "retain",
      "label": "Retain",
      "description": "The business continues the relationship and creates additional value."
    }
  ],
  "dimensions": [
    {
      "id": "marketing_strategy",
      "label": "Marketing Strategy",
      "description": "Direction and market alignment: objectives, market opportunity, audience, positioning, offers, channels, priorities, and acquisition strategy."
    },
    {
      "id": "ux_design",
      "label": "UX Design",
      "description": "Experience and interaction: usability, navigation, information, digital experience, interactions, conversion paths, and friction."
    },
    {
      "id": "brand_identity",
      "label": "Brand Identity",
      "description": "Meaning and expression: positioning, messaging, visual identity, verbal identity, differentiation, trust, relevance, and brand experience."
    },
    {
      "id": "systems_integration",
      "label": "Systems & Integration",
      "description": "Infrastructure and connection: CRM, analytics, tracking, automation, data, technology, lead management, workflows, and integrations."
    }
  ],
  "response_model": {
    "type": "maturity_1_5",
    "fields": {
      "criterion_id": {
        "type": "string",
        "required": true
      },
      "value": {
        "type": [
          "integer",
          "null"
        ],
        "range": [
          1,
          5
        ],
        "required": true,
        "description": "1-5 maturity value; null only when applicability is not_applicable."
      },
      "evidence": {
        "type": "string",
        "required": true,
        "description": "Supporting explanation. Separate from the score -- the deterministic engine does not reinterpret evidence to change the score."
      },
      "applicability": {
        "type": "string",
        "enum": [
          "applicable",
          "not_applicable"
        ],
        "required": true
      }
    }
  },
  "applicability_model": {
    "values": [
      "applicable",
      "not_applicable"
    ],
    "effect_of_not_applicable": {
      "score": null,
      "classification": null,
      "finding": null,
      "severity": null
    },
    "note": "Non-applicable capabilities are not weaknesses."
  },
  "classification_model": {
    "scale": "maturity_1_5",
    "bands": [
      {
        "score": 1,
        "classification": "needs_attention",
        "meaning": "Absent / severely limited"
      },
      {
        "score": 2,
        "classification": "needs_attention",
        "meaning": "Informal / inconsistent"
      },
      {
        "score": 3,
        "classification": "developing",
        "meaning": "Functional / defined"
      },
      {
        "score": 4,
        "classification": "strong",
        "meaning": "Intentional / structured"
      },
      {
        "score": 5,
        "classification": "operationalized",
        "meaning": "Integrated / continuously improved"
      }
    ]
  },
  "severity_model": {
    "levels": [
      {
        "id": "low",
        "meaning": "Improvement opportunity with limited immediate/systemic consequence"
      },
      {
        "id": "moderate",
        "meaning": "Meaningful weakness that may constrain performance"
      },
      {
        "id": "high",
        "meaning": "Significant weakness that may materially affect the journey or connected areas"
      },
      {
        "id": "critical",
        "meaning": "Fundamental condition that may substantially prevent the relevant journey stage from functioning"
      }
    ],
    "derivation_rule": "TBD",
    "note": "Severity is separate from score and classification and must not be a simple one-to-one mapping from score (Design Spec §11). The rule that assigns severity per criterion/condition is not defined in the source documents and is not invented here."
  },
  "finding_model": {
    "types": [
      "issue",
      "opportunity",
      "strength"
    ],
    "fields": {
      "finding_id": {
        "type": "string",
        "required": true
      },
      "criterion_id": {
        "type": "string",
        "required": true
      },
      "journey_stage": {
        "type": "string",
        "required": true
      },
      "dimension": {
        "type": "string",
        "required": true
      },
      "type": {
        "type": "string",
        "enum": [
          "issue",
          "opportunity",
          "strength"
        ],
        "required": true
      },
      "severity": {
        "type": [
          "string",
          "null"
        ],
        "enum": [
          "low",
          "moderate",
          "high",
          "critical",
          null
        ]
      }
    },
    "generation_rule": "TBD",
    "note": "Not every criterion must produce a finding (Design Spec §10). The condition that triggers a finding, and which type it produces, is not defined in the source documents and is not invented here."
  },
  "rule_types": [
    {
      "type": "threshold",
      "description": "Maps numeric values to bands.",
      "v1_usage": "Primary rule type for V1 -- used by all 51 criteria via classification_model.bands."
    },
    {
      "type": "match",
      "description": "Maps categorical responses to defined outcomes.",
      "v1_usage": "Supported by the schema; not used by any V1 criterion (all 51 are maturity_1_5)."
    },
    {
      "type": "conditional",
      "description": "Allows conditional evaluation and applicability logic.",
      "v1_usage": "Supported by the schema; not used by any V1 criterion."
    },
    {
      "type": "weighted_sum",
      "description": "Aggregates multiple criteria into a category/dimension score via weights.",
      "v1_usage": "Reserved for future composite rules; not used in V1. No V1 criterion carries a weight field."
    },
    {
      "type": "cross_reference",
      "description": "Compares results across categories.",
      "v1_usage": "Deferred -- not implemented in V1 (Design Spec §8)."
    }
  ],
  "aggregation": {
    "dimension": {
      "method": "TBD",
      "preserves": [
        "criterion_results",
        "findings",
        "classification_distribution",
        "severity_distribution",
        "concentration_pattern_information"
      ],
      "note": "Design Spec §13: dimension aggregation is 'not a simple average'; the exact aggregation classification logic is proprietary and undefined in the source documents."
    },
    "journey": {
      "method": "TBD",
      "preserves": [
        "criterion_results",
        "findings",
        "classification_distribution",
        "severity_distribution"
      ],
      "note": "Design Spec §14: journey aggregation preserves structure rather than reducing the stage to an average. The same criterion result contributes to both its journey result and its dimension result."
    },
    "overall_score": null,
    "overall_score_note": "V1 deliberately does not reduce the entire business to a single number (Design Spec §20)."
  },
  "priority": {
    "included_in_v1": true,
    "signals": [
      "severity",
      "concentration",
      "explicit_relationships",
      "potential_impact"
    ],
    "precedence_order": [
      "critical_severity",
      "high_severity_with_broad_or_concentrated_impact",
      "high_severity",
      "moderate_severity_with_meaningful_concentration",
      "moderate_severity",
      "low_severity"
    ],
    "tie_breakers": [
      "broader_explicit_relationship",
      "greater_concentration",
      "greater_journey_relevance"
    ],
    "scoring_formula": "TBD",
    "root_cause_statuses": [
      "none_identified",
      "explicit_relationship",
      "potential_relationship"
    ],
    "note": "Design Spec §16-§18: an ordered list of qualitative signals is defined, not a numeric scoring function or cutoffs. A priority is not simply the lowest score. Sophisticated root-cause inference is deferred beyond V1; V1 must not claim causal certainty from correlation alone."
  },
